# Copy to .env and fill real values. Do NOT commit .env with secrets.
# Example variables
PORT=5000
DB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>
ACCESS_SECRET=your_access_token_secret_here
REFRESH_SECRET=your_refresh_token_secret_here
GEMINI_API_KEY=
# Judge0 API (hosted / remote service only; no Docker required)
JUDGE0_API_URL=https://your-judge0-instance.example.com
JUDGE0_API_KEY=your-judge0-api-key
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_AUTH_TYPE=token
# Backward-compatible alias for older setups
JUDGE0_URL=https://your-judge0-instance.example.com
# FRONTEND_URL / CLIENT_URL used for invite link generation
FRONTEND_URL=https://your-vercel-url.vercel.app
CLIENT_URL=https://your-vercel-url.vercel.app
